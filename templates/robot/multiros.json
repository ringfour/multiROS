{
  "schema": 1,
  "project": "robot-dev",
  "compose": [
    "compose.yaml"
  ],
  "service": "ros-dev",
  "submodules": [
    "tools/multiros"
  ],
  "rendering_base": true,
  "container": {
    "image": "robot-dev:local",
    "dockerfile": "docker/Dockerfile",
    "workdir": "/workspace/robot",
    "gpu": false,
    "mounts": [
      {
        "source": "{root}",
        "target": "/workspace/robot"
      }
    ],
    "environment": {},
    "ports": []
  },
  "commands": {}
}
